<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-lib-events — event envelope (Doc 07 §6) + Avro schemas (Doc 07 §9).
  Content-free envelope carrying correlation + causation ids for cross-service replay.
  Avro schemas compiled by avro-maven-plugin (backward-compatible evolution, Doc 07 §9 / Doc 16 D-033).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-lib-events</artifactId>
  <name>Reliability-First AI Gateway :: Lib :: Events</name>

  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>${avro.version}</version>
        <executions>
          <execution>
            <phase>generate-sources</phase>
            <goals><goal>schema</goal></goals>
            <configuration>
              <sourceDirectory>${project.basedir}/src/main/avro</sourceDirectory>
              <outputDirectory>${project.build.directory}/generated-sources/avro</outputDirectory>
              <stringType>String</stringType>
              <fieldVisibility>PRIVATE</fieldVisibility>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
