<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-provider-openai — Provider Adapter V1 (Doc 25, AD-002/AD-007). A pure-JDK anti-corruption
  layer for the OpenAI HTTP API, sitting entirely behind ProviderTransportPort/ProviderTranslator.
  No business logic lives here; replacing this module changes no caller.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-provider-openai</artifactId>
  <name>Reliability-First AI Gateway :: Provider :: OpenAI (Adapter V1)</name>
  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-dp-provider-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-dp-streamguard</artifactId>
    </dependency>
    <!-- AD-030: the embedding ports this module's embeddings adapter implements. -->
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-dp-embedding</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <!--
    The two loopback HTTP fixtures use the JDK's jdk.httpserver module
    (com.sun.net.httpserver), which jdk-non-portable intentionally flags.
    Exclude only those compiled test fixtures from forbiddenapis scanning;
    JUnit still runs them, every other test class remains checked, and no
    production class matches these exact test-only class-name patterns.
    Include inner classes because Responder references HttpExchange.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>de.thetaphi</groupId>
        <artifactId>forbiddenapis</artifactId>
        <configuration>
          <excludes>
            <exclude>**/FakeOpenAiServer*.class</exclude>
            <exclude>**/HttpEmbeddingTransportTest*.class</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
