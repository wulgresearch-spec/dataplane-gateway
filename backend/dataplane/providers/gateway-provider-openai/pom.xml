<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-provider-openai — Provider Adapter V1 (Doc 25, AD-002/AD-007). A pure-JDK anti-corruption
  layer for the OpenAI HTTP API, sitting entirely behind ProviderTransportPort/ProviderTranslator.
  No business logic lives here; replacing this module changes no caller.
-->
