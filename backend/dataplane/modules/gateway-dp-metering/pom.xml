<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-metering — the Usage Metering Engine (C5, Doc 23). Deterministic, record-only usage-fact
  engine: normalize execution facts → immutable canonical UsageFacts (never fabricate/estimate) →
  durable WAL commit (RPO=0) → ledger/quota/cost emission; fail-closed (UME-INV). Provider-neutral,
  credential-free, SDK-free, HTTP-free, store-free. Depends on canonical + ports (ClockPort) + common.
-->
