<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-schemalock — SchemaLock, the structured-output correctness engine (C3, Doc 17).
  Deterministic resolution engine: strategy selection, bounded content-hash schema cache, NR-1
  conservative repair, fail-closed classification, terminal-gated streaming. The JSON Schema validator
  is a replaceable SchemaValidatorPort adapter (SL-D6) — no validator library in the module. Depends on
  canonical (CorrelationId) + common (inward, R-017).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-dp-schemalock</artifactId>
  <name>Reliability-First AI Gateway :: DP :: SchemaLock</name>
  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <!--
      SchemaLockService takes a ClockPort. This dependency was missing: the local javac harness
      compiled every module into one output directory, so the reference resolved without it and the
      omission stayed invisible until Maven built the modules separately.
    -->
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
