<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-plugin-runtime — the Sandboxed Plugin Runtime (Doc 28, C12 data-plane presence, AD-004).
  It verifies, loads, executes, isolates and unloads plugins that the C12 control plane already vetted
  and signed. It never vets, registers-of-record, signs, publishes or authors provenance (Doc 28 ROC-8),
  owns no store, and knows nothing of providers (Doc 28 §31.1).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-dp-plugin-runtime</artifactId>
  <name>Reliability-First AI Gateway :: DP :: Plugin Runtime (C12)</name>
  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <!--
    Plugin Runtime's System.nanoTime() uses are elapsed-time measurements for sandbox
    resource usage and streaming telemetry, not ambient time in policy decision cores.
    Override only the custom signature list to allow that one monotonic primitive.
    The inherited jdk-unsafe, jdk-deprecated, and jdk-non-portable bundles remain
    active, as do every other custom forbidden signature in the module-specific file.
    No parent or other module's forbidden API configuration is changed.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>de.thetaphi</groupId>
        <artifactId>forbiddenapis</artifactId>
        <configuration>
          <signaturesFiles combine.self="override">
            <signaturesFile>${build-tools.dir}/forbidden-signatures-plugin-runtime.txt</signaturesFile>
          </signaturesFiles>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
