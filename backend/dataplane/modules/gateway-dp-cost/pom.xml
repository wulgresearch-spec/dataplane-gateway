<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-cost — the Cost Engine (C5, Doc 22). Deterministic, calculation-only cost engine: versioned
  pricing/FX snapshots, deterministic precedence, never-underestimated projections, exact actual cost;
