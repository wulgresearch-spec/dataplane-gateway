<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-embedding — provider-neutral embedding generation (AD-030, closes B25).

  Generates embeddings. It does not index them, search them, compare them or retrieve anything —
  those are B26 and beyond. The Memory Runtime depends on nothing here; this module depends on the
  Memory Runtime only to implement its EmbeddingPort, and on the provider adapter module for
  ProviderId and the shared HTTP failure classification.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-dp-embedding</artifactId>
  <name>Reliability-First AI Gateway :: DP :: Embedding Provider</name>
  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-dp-provider-adapter</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-dp-memory-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
