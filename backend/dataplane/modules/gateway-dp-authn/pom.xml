<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-authn — the data-plane C6 authentication node (Doc 37). Verifies the forwarded caller
  identity against pinned public verification-key snapshots (AD-022), resolves tenant scope only after
  success (Doc 32 SPT), authenticates only (never authorizes, Doc 37 ANZ), holds no secret (IAU-A9),
  and fails closed. Depends only on canonical + ports + common (inward, Doc 11 R-017).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-dp-authn</artifactId>
  <name>Reliability-First AI Gateway :: DP :: Authentication</name>

  <properties>
    <!-- IAU-A15 (Doc 37 §18): authentication conformance harness mutation target. -->
    <mutation.threshold>90</mutation.threshold>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
