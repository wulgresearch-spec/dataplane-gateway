<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-secrets-provider — the data-plane Secret cache (C14, Doc 26). Materializes single-use,
  zeroizable, in-memory credential leases from the cached short-TTL C14 snapshot (AD-022); owns no
  store, makes no synchronous C14 call, holds no secret in a String (Doc 26 SP-INV). Depends only on
  canonical + ports + common (inward, Doc 11 R-017).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-dp-secrets-provider</artifactId>
  <name>Reliability-First AI Gateway :: DP :: Secrets Provider</name>

  <properties>
    <!-- SP-A15 (Doc 26 §27): maximally-critical security module mutation target. -->
    <mutation.threshold>90</mutation.threshold>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-ports</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
