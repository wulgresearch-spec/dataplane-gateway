<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-event-publisher — the data-plane event-fabric adapter (Doc 07, Doc 38 §4 emitter role).
  Implements the frozen EventPublisherPort with production resilience: idempotent id assignment, retry
  with error classification, WAL-before-send for zero-loss, and DLQ routing. Broker/WAL/DLQ are ports
  (the Kafka-class backbone + durable store are infrastructure, wired at composition — not faked).
-->
