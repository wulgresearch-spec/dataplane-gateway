<?xml version="1.0" encoding="UTF-8"?>
<!--
  gateway-dp-memory-pii — production PII detection for the Memory Runtime (AD-029, closes B23).

  A deterministic rule engine: compiled patterns, checksum validators, context scoring, and layered
  built-in / organization / tenant rule sets. It classifies. It does not store, encrypt, embed,
  retrieve, rank or decide policy — those belong to C17, AD-027 and AD-028 respectively.

  No model, no network, no service. The only dependency is the Memory Runtime whose port it implements.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.reliabilityai.gateway</groupId>
    <artifactId>gateway-backend-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../../pom.xml</relativePath>
  </parent>
  <artifactId>gateway-dp-memory-pii</artifactId>
  <name>Reliability-First AI Gateway :: DP :: Memory PII Detection</name>
  <dependencies>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-common</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-lib-canonical</artifactId>
    </dependency>
    <dependency>
      <groupId>io.reliabilityai.gateway</groupId>
      <artifactId>gateway-dp-memory-runtime</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
